# Copie este arquivo para .env e ajuste os valores ao seu ofício.

# Caminho da pasta-raiz do workspace "Ofício Geral" do seu ofício.
# Ex.: C:\Users\<seu_usuario>\Desktop\Ofício Geral
# Se vazio, config.py usa ~/Desktop/Ofício Geral.
OFICIO_GERAL=

# Credenciais do SISDPU (para a sincronizacao automatica)
SISDPU_USERNAME=seu.usuario
SISDPU_PASSWORD=sua.senha

# Ajustes do sincronizador (opcional — defaults sensatos em config.py)
RATE_LIMIT_SISDPU_SEG=2
TIMEOUT_TOTAL_SEG=3600
# Limite de anexos baixados por PAJ (30 = default; >= 1 recomendado)
MAX_ANEXOS_POR_PAJ=30

# Timeout por pagina no Tesseract (segundos). Default 30.
# Aumente se voce tem PDFs escaneados muito densos; diminua pra cancelar
# travamentos mais rapido.
TIMEOUT_OCR_POR_PAGINA_SEG=30

# Pasta onde DOCX/PDF gerados sao salvos.
# Default: <OFICIO_GERAL>/Peças Feitas
# DOCGEN_OUT_DIR=C:\caminho\custom\Peças Feitas

# ---------------------------------------------------------------------------
# Integracao PJe / MNI — consulta processual SOMENTE LEITURA (sem peticionamento)
# ---------------------------------------------------------------------------
# Endpoint do webservice MNI. Default = TRF3 1o grau (Vara Federal e JEF Osasco).
# 2o grau TRF3: https://pje2g.trf3.jus.br/pje/intercomunicacao?wsdl
PJE_MNI_WSDL=https://pje1g.trf3.jus.br/pje/intercomunicacao?wsdl
# Credenciais institucionais DPU habilitadas pelo tribunal (idConsultante/senha).
# DEIXE EM BRANCO ate obte-las junto a TI da DPU / TRF3.
PJE_MNI_ID_CONSULTANTE=
PJE_MNI_SENHA_CONSULTANTE=
# Verificacao TLS. SEMPRE true em producao. "false" so para diagnostico pontual.
PJE_MNI_VERIFY_TLS=true
PJE_MNI_TIMEOUT_SEG=60
# Quantas pecas mais recentes baixar por consulta.
PJE_MAX_PECAS=15

# --- Acesso ao PJe via NAVEGADOR (login manual + sessao persistente) ---
# Caminho alternativo ao MNI. NAO ha senha aqui: o login e' manual na janela do
# navegador e a sessao fica salva localmente (fora do git). Sua senha nunca e'
# armazenada por este projeto.
PJE_WEB_LOGIN_URL=https://pje1g.trf3.jus.br/pje/login.seam
PJE_WEB_HOST=pje1g.trf3.jus.br
# Onde a sessao do navegador fica salva (local, ignorado pelo git).
# Default: <projeto>/.pje_session
# PJE_WEB_USER_DATA_DIR=C:\DPU\sis-dpu\.pje_session
# Tempo maximo (s) para concluir o login manual.
PJE_WEB_LOGIN_TIMEOUT_SEG=300
